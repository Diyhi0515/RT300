# Proxy HTTPS para probar/producir con TLS. Caddy emite un certificado propio ("tls internal") y renueva solo.
# En un servidor real con dominio público, reemplazar las direcciones por el dominio y quitar "tls internal"
# (Caddy obtiene un certificado de Let's Encrypt automáticamente).
{
	auto_https disable_redirects
	default_sni 127.0.0.1
}

https://127.0.0.1:8443, https://localhost:8443 {
	tls internal

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:5173
	}
}
