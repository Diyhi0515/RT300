# Copiar como .env.local-db en la otra laptop. NO subir el archivo real a Git.

# Puerto al que ingresarán las tablets/PC de la misma red:
APP_PORT=8080

# Genere dos valores diferentes, largos y aleatorios. Ejemplo en PowerShell:
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
SECRET_KEY=REEMPLAZAR_CON_VALOR_ALEATORIO_1
JWT_SECRET_KEY=REEMPLAZAR_CON_VALOR_ALEATORIO_2_DE_32_O_MAS

# SQL Server instalado en esta misma laptop (fuera de Docker).
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=tbpos_new
DB_USER=rt300_app
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_REAL
DB_TRUST_CERT=yes

# El frontend y la API usan el mismo origen. Agregue la IP real de la laptop.
# Ejemplo: http://192.168.1.50:8080
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://192.168.1.50:8080

# Servicio real de comandas. Para probar sin imprimir use GATEWAY_MODE=fake.
GATEWAY_MODE=soap
GATEWAY_WSDL_URL=http://192.168.0.2/RT300WS/RT300.asmx
GATEWAY_PASSWORD=
GATEWAY_TIMEOUT_SECONDS=30

# Carpeta local con imágenes. Se monta en solo lectura dentro del backend.
IMAGENES_DIR=./img/Restaurantes

ADMIN_USERS=
CAJERO_USERS=
MENU_CACHE_SECONDS=300
RATE_LIMIT_DEFAULT=300 per minute
