# Copiar a .env (no se sube a Git). Todos los valores tienen un valor por defecto razonable.

# ── SQL Server (contenedor de PRUEBAS; no usar en producción) ──
MSSQL_SA_PASSWORD=Rt300_Sa_2026!
DB_PORT=1433                     # puerto publicado en tu PC. Cámbialo (ej. 1434) si el proyecto antiguo está encendido
DB_USER=rt300_app
DB_PASSWORD=Rt300App2026x

# Ruta del backup de la BD (relativa a esta carpeta o absoluta). Ajusta a donde esté el .bak
BACKUP_FILE=./docker/backup/tbpos_new.bak   # Docker no ve la unidad F:, copiar el .bak aquí

# ── Backend ──
SECRET_KEY=dev-secret-cambiar
JWT_SECRET_KEY=dev-jwt-secret-cambiar-por-uno-largo-de-32-o-mas
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Servicio de comandas. En el servidor del club: GATEWAY_MODE=soap y la MISMA URL que usaba el PHP (SYS_WEBSERVICE_DIR).
GATEWAY_MODE=fake                # fake | soap | dll | http
GATEWAY_WSDL_URL=                # ej. http://192.168.0.2/RT300WS/RT300.asmx   (con o sin ?WSDL)
GATEWAY_HTTP_URL=

# Carpeta de imágenes de platos (copiada del proyecto antiguo: img/Restaurantes)
IMAGENES_DIR=./img/Restaurantes

# ── Frontend ──
VITE_API_URL=http://127.0.0.1:5000/api/v1

# ── Reutilizar la BD del proyecto antiguo (opcional) ──
# DB_HOST=host.docker.internal
# DB_INTERNAL_PORT=1433
# y levantar solo: docker compose up -d --build --no-deps backend frontend

# ── Roles y gateway (backend) ──
FLASK_ENV=development            # production exige SECRET_KEY/JWT_SECRET_KEY propios
ADMIN_USERS=                     # usuarios admin separados por coma (mapeo de roles pendiente: docs/00 §8 #5)
CAJERO_USERS=
GATEWAY_PASSWORD=                # credencial técnica hacia el servicio de comandas (decisión pendiente)

# ── Rendimiento y red (backend) ──
MENU_CACHE_SECONDS=300           # caché del menú en memoria; 0 la desactiva (el menú cambia poco)
PROXY_HOPS=0                     # proxies de confianza delante de Flask (nginx=1); 0 si se accede directo
RATE_LIMIT_DEFAULT=300 per minute  # límite general por IP (el login tiene límites propios más estrictos)
REDIS_PASSWORD=Rt300Redis2026x   # Redis solo es accesible dentro de Docker; cambiar en producción
